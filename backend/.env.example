# ── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for development — leave this line uncommented)
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL example (comment the sqlite line and uncomment this for production):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Production Security (set DEBUG=False and configure these in prod) ──────────
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
